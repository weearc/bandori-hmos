# Files whose bytes are verified by a recorded digest must not be line-ending
# converted: a CRLF checkout changes the SHA-256 and breaks the build checks.
*.pem   -text
*.crt   -text
*.cer   -text
*.p12   -text
*.p7b   -text
*.so    -text
*.a     -text
*.o     -text
*.png   -text
*.jpg   -text
*.jpeg  -text
*.hap   -text
*.apk   -text
*.dex   -text
*.bin   -text

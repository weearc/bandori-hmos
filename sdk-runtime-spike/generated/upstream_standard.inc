 *
 * The part of the class library the interpreter has to own.
 *
 * An APK ships its own classes, not the platform's, so `java/lang/String` and
 * friends have no bytecode anywhere in the dex.  Routing those to the JNI stub
 * layer would not work either: `StringBuilder.append` is what every string
 * concatenation in the app compiles to, and it has to return the *same*
 * builder so the next append chains.  So the VM implements them directly.
 *
 * Scope is set by what app glue code actually uses: strings and builders,
 * boxing, Math, System, the exception hierarchy, and small collections.
 * Anything else stays an external class and goes to the host stubs.
 */
/* MPL derivative generated by extract_standard_runtime.py. */

static bool sb_reserve(struct dvm *vm, struct dvm_object *o, size_t length)
{
   if (length >= 1048576) {
      dvm__throw(vm, "java/lang/OutOfMemoryError", "builder capacity"); return false;
   }
   uint32_t need=(uint32_t)length+1;
   if (o->utf8 && need<=o->builder_capacity) return true;
   uint32_t cap=o->builder_capacity ? o->builder_capacity : 32;
   while (cap<need) cap=cap>UINT32_MAX/2 ? need : cap*2;
   char *nb=realloc(o->utf8,cap);
   if (!nb) {
      dvm__throw(vm, "java/lang/OutOfMemoryError", "builder capacity"); return false;
   }
   o->utf8=nb; o->builder_capacity=cap;
   return true;
}

static void sb_append(struct dvm *vm, dvm_ref self, const char *text, size_t n)
{
   struct dvm_object *o = dvm__obj(vm, self);
   if (!o || !n) return;
   size_t have = o->utf8 ? o->utf8_len : 0;
   /* append(this) and ranged self-appends must survive a moving realloc. */
   uintptr_t base=(uintptr_t)o->utf8, source=(uintptr_t)text;
   bool own=o->utf8 && source>=base && source-base<=have;
   size_t offset=own ? (size_t)(source-base) : 0;
   if (n>UINT32_MAX-have-1 || !sb_reserve(vm,o,have+n)) {
      if (!dvm_exception(vm)) dvm__throw(vm,"java/lang/OutOfMemoryError","builder capacity");
      return;
   }
   if (own) text=o->utf8+offset;
   memmove(o->utf8+have,text,n);
   o->utf8[have+n]='\0';
   o->utf8_len=(uint32_t)(have+n);
}

static bool sb_init(struct dvm *vm, dvm_ref self, const union dvm_value *args,
                    int nargs, union dvm_value *out)
{
   (void)args; (void)nargs; (void)out;
   struct dvm_object *o = dvm__obj(vm, self);
   if (!o) RETV();
   free(o->utf8);
   o->utf8 = strdup("");
   o->utf8_len = 0;
   o->builder_capacity = o->utf8 ? 1 : 0;
   if (!o->utf8) { dvm__throw(vm,"java/lang/OutOfMemoryError","builder"); return false; }
   RETV();
}

static bool sb_toString(struct dvm *vm, dvm_ref self, const union dvm_value *args,
                        int nargs, union dvm_value *out)
{
   (void)args; (void)nargs;
   struct dvm_object *o = dvm__obj(vm, self);
   RETL(dvm_new_string_n(vm, o && o->utf8 ? o->utf8 : "", o ? o->utf8_len : 0));
}

static bool runtime_getRuntime(struct dvm *vm, dvm_ref self,
                               const union dvm_value *args, int nargs,
                               union dvm_value *out)
{
   (void)self; (void)args; (void)nargs;
   if (!vm->runtime_instance) {
      struct dvm_class *c = dvm__class_by_desc(vm, "Ljava/lang/Runtime;");
      vm->runtime_instance = c ? dvm_new_object(vm, c) : 0;
      if (vm->runtime_instance) dvm_pin(vm, vm->runtime_instance);
   }
   RETL(vm->runtime_instance);
}

static void uuid_bits(struct dvm *vm, dvm_ref self, uint64_t *msb, uint64_t *lsb)
{
   union dvm_value v;
   memset(&v, 0, sizeof v);
   (void)dvm_get_field(vm, self, "msb", "J", &v);
   *msb = (uint64_t)v.j;
   memset(&v, 0, sizeof v);
   (void)dvm_get_field(vm, self, "lsb", "J", &v);
   *lsb = (uint64_t)v.j;
}

static bool uuid_init(struct dvm *vm, dvm_ref self,
                      const union dvm_value *args, int nargs,
                      union dvm_value *out)
{
   (void)out;
   (void)nargs;
   if (!dvm_set_field(vm, self, "msb", "J", args[0]) ||
       !dvm_set_field(vm, self, "lsb", "J", args[1])) return false;
   RETV();
}

static bool uuid_randomUUID(struct dvm *vm, dvm_ref self,
                            const union dvm_value *args, int nargs,
                            union dvm_value *out)
{
   (void)self; (void)args; (void)nargs;
   struct dvm_class *c = dvm__class_by_desc(vm, "Ljava/util/UUID;");
   dvm_ref u = c ? dvm_new_object(vm, c) : 0;
   if (!u) RETL(0);

   uint64_t bits[2];
   if (runtime_random_bytes((unsigned char *)bits, sizeof bits) != 1) {
      dvm__throw(vm, "java/lang/InternalError", "UUID random source failed");
      return false;
   }
   uint64_t msb = bits[0], lsb = bits[1];
   /* Version 4, IETF variant — callers do parse these bits. */
   msb = (msb & ~0xf000ULL) | 0x4000ULL;
   lsb = (lsb & ~(0xc0ULL << 56)) | (0x80ULL << 56);

   union dvm_value v = { 0 };
   v.j = (int64_t)msb;
   (void)dvm_set_field(vm, u, "msb", "J", v);
   v.j = (int64_t)lsb;
   (void)dvm_set_field(vm, u, "lsb", "J", v);
   RETL(u);
}

static bool uuid_toString(struct dvm *vm, dvm_ref self,
                          const union dvm_value *args, int nargs,
                          union dvm_value *out)
{
   (void)args; (void)nargs;
   uint64_t msb, lsb;
   uuid_bits(vm, self, &msb, &lsb);
   char buf[40];
   snprintf(buf, sizeof buf, "%08x-%04x-%04x-%04x-%012llx",
            (unsigned)(msb >> 32), (unsigned)((msb >> 16) & 0xffff),
            (unsigned)(msb & 0xffff), (unsigned)((lsb >> 48) & 0xffff),
            (unsigned long long)(lsb & 0xffffffffffffULL));
   RETL(dvm_new_string(vm, buf));
}

static bool uuid_msb(struct dvm *vm, dvm_ref self, const union dvm_value *args,
                     int nargs, union dvm_value *out)
{
   (void)args; (void)nargs;
   uint64_t msb, lsb;
   uuid_bits(vm, self, &msb, &lsb);
   RETJ((int64_t)msb);
}

static bool uuid_lsb(struct dvm *vm, dvm_ref self, const union dvm_value *args,
                     int nargs, union dvm_value *out)
{
   (void)args; (void)nargs;
   uint64_t msb, lsb;
   uuid_bits(vm, self, &msb, &lsb);
   RETJ((int64_t)lsb);
}

static bool uuid_equals(struct dvm *vm, dvm_ref self, const union dvm_value *args,
                        int nargs, union dvm_value *out)
{
   (void)nargs;
   dvm_ref other = ARG(0).l;
   if (!other) RETI(0);
   struct dvm_class *c = dvm_object_class(vm, other);
   if (!c || !c->name || strcmp(c->name, "java/util/UUID")) RETI(0);
   uint64_t a0, a1, b0, b1;
   uuid_bits(vm, self, &a0, &a1);
   uuid_bits(vm, other, &b0, &b1);
   RETI(a0 == b0 && a1 == b1);
}
